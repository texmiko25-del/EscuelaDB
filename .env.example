# Configuración principal
SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Correo y destinatarios opcionales
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SYSTEM_NOTIFICATION_EMAIL=
WHATSAPP_RECIPIENT=

# Respuestas a mensajes de contacto por Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API de Meta (respuestas a contactos; plantilla aprobada con {{1}})
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_CONTACT_REPLY_TEMPLATE_NAME=escuela_respuesta_contacto
WHATSAPP_CONTACT_REPLY_TEMPLATE_LANGUAGE=es

# WhatsApp con Twilio (avisos de calificaciones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
